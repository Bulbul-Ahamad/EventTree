# Copy to .env.local (git-ignored) and fill in. See docs/04_TRD.md section 4.

# Supabase project URL. Local stack default shown.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Anon / publishable key (safe to expose, protected by RLS). Printed by `pnpm db:start`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical site URL, used for auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER SCRIPTS ONLY (scripts/seed.ts, local Supabase only).
# Never import in src/, never set in Vercel.
SUPABASE_SERVICE_ROLE_KEY=
